{
    "name": "gavg/fluenter-eloquent-collections",
    "description": "Adds fluent magic relationship accessors and event-aware query updates to Eloquent Collections.",
    "keywords": [
        "laravel",
        "eloquent",
        "collection",
        "orm"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "GavG",
            "email": "gavg.apps@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "GavG\\FluenterEloquentCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GavG\\FluenterEloquentCollections\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GavG\\FluenterEloquentCollections\\FluenterEloquentCollectionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}